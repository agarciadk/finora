// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationPreferenceType {
  BUDGET_ALERTS
  WEEKLY_SUMMARY
  PRODUCT_NEWS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerified Boolean @default(false)
  // Both tokens are stored as an HMAC hash (see auth/token.util.ts), never in
  // clear text — same pattern already used for RefreshToken.tokenHash.
  verificationToken    String?   @unique
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // Smart Assistant profile data (Epic 7.3.1): used to project expected
  // income and compute the "Margen Vital" (expected income - recurring
  // expenses). Range (1-31) is validated at the DTO level, not in Prisma.
  mainIncomeSource String?
  payday           Int?

  accounts                 Account[]
  categories               Category[]
  transactions             Transaction[]
  budgets                  Budget[]
  recurringPayments        RecurringPayment[]
  notificationPreferences  NotificationPreference[]
  refreshTokens            RefreshToken[]
  sessions                 Session[]
  auditLogs                AuditLog[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  sessionId  String
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

// A stable device/browser login that survives refresh-token rotation.
// `refreshTokenHash` always mirrors the hash of the currently active
// RefreshToken row for this session (updated on every rotation).
model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  lastActive       DateTime @default(now())
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  name      String
  bank      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  currency  String      @default("EUR")
  // IBAN (Smart Assistant, Epic 7.3.1): optional, used to help the assistant
  // recognize internal transfers between the user's own accounts.
  iban      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  // Interest-bearing accounts (Cuentas Remuneradas): all three are optional
  // because most accounts (checking, cash, credit cards) don't earn interest.
  interestRate       Decimal? @db.Decimal(5, 2)
  taxRate            Decimal? @db.Decimal(5, 2)
  interestPaymentDay Int?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  recurringPayments RecurringPayment[]

  @@index([userId])
}

model Category {
  id        String          @id @default(uuid())
  userId    String
  name      String
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  // Marks internal transfers between the user's own accounts (Epic 7.3.1):
  // MUST be excluded from analytics (income/expenses/category breakdown) so
  // moving money between accounts doesn't inflate the user's real cashflow.
  isTransfer  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
}

model Budget {
  id         String    @id @default(uuid())
  userId     String
  categoryId String
  limit      Decimal   @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId])
}

model RecurringPayment {
  id              String             @id @default(uuid())
  userId          String
  accountId       String
  categoryId      String
  name            String
  amount          Decimal            @db.Decimal(12, 2)
  type            TransactionType
  frequency       RecurringFrequency
  startDate       DateTime
  nextPaymentDate DateTime
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([userId, nextPaymentDate])
}

model NotificationPreference {
  id      String                     @id @default(uuid())
  userId  String
  type    NotificationPreferenceType
  enabled Boolean                    @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  action     AuditAction
  entityName String
  entityId   String?
  ipAddress  String?
  details    Json?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}