# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://postgres:change-me@localhost:5432/finora"

# Secret used to sign short-lived JWT access tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"

# Secret used to HMAC-hash refresh tokens before storing them in the database.
# Generate the same way as JWT_ACCESS_SECRET.
REFRESH_TOKEN_HASH_SECRET="change-me"

# Cookie SameSite policy for the auth cookies ("lax", "strict" or "none").
# Use "none" if the frontend and API are served from different origins
# without a same-site reverse proxy in front of them.
COOKIE_SAME_SITE="lax"

# Origin(s) allowed to send credentialed (cookie) requests to the API.
CORS_ORIGIN="http://localhost:5173"

# Base URL of the frontend, used to build the links sent in verification and
# password reset emails.
FRONTEND_URL="http://localhost:5173"

# SMTP credentials for MailService (apps/api/src/mail). If SMTP_HOST is unset,
# emails are logged to the console instead of actually being sent — handy for
# local dev/CI. Set these to point at a real provider (or Ethereal for testing).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@finora.app"

