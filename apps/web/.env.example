# In dev, Vite proxies /api to the backend (see vite.config.ts) so requests
# stay same-origin and auth cookies work with SameSite=Lax. Point this at the
# full API origin instead if you disable the proxy or deploy without one.
VITE_API_URL=/api

# Idle-warning modal and auto-logout thresholds, in minutes (see
# apps/web/src/lib/idle-config.ts). Default to 14/15 if unset; lower both for
# fast manual/e2e testing of the idle-warning flow.
VITE_IDLE_WARNING_MINUTES=14
VITE_IDLE_LOGOUT_MINUTES=15
