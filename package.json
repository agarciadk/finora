{
  "name": "personal-finance-manager",
  "private": true,
  "version": "rc-0.1.0",
  "description": "A modern full-stack personal finance platform to manage accounts, track transactions, set budgets, and analyze financial health.",
  "homepage": "https://github.com/agarciadk/personal-finance-manager#readme",
  "bugs": {
    "url": "https://github.com/agarciadk/personal-finance-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agarciadk/personal-finance-manager.git"
  },
  "license": "Apache-2.0",
  "author": "Alberto Garcia de Paredes Cidoncha <agarciadk@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clear": "rm -rf node_modules dist pnpm-lock.yaml && pnpm install",
    "clean": "rm -rf node_modules dist test/node_modules test_e2e/node_modules pnpm-lock.yaml && pnpm install",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "pnpm --filter ./test test",
    "test:e2e": "pnpm --filter ./test_e2e test:e2e",
    "test:e2e:ui": "pnpm --filter ./test_e2e test:e2e:ui",
    "test:a11y": "pnpm --filter ./test_e2e test:a11y",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
